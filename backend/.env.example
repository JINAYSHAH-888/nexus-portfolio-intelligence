# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nippon:nippon@localhost:5432/nippon

# ── Auth ──────────────────────────────────────────────────────────────────────
# MUST be changed for any real deployment. The app REFUSES to boot in
# production with the placeholder or anything shorter than 32 chars.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis is a CACHE, not a database: with REDIS_ENABLED=false (or Redis simply
# down) the API stays fully correct, just slower on repeat market-data reads.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Market data ───────────────────────────────────────────────────────────────
# Optional. Without it, fundamentals fall back to yfinance.
ALPHA_VANTAGE_API_KEY=
AMFI_BASE_URL=https://api.mfapi.in
AMFI_NAV_REFRESH_DAYS=1
# Never set true in production -- it would serve simulated returns to real
# investors, and the app refuses to boot with it on.
MARKET_DATA_FORCE_SYNTHETIC=false

# ── ARISE ─────────────────────────────────────────────────────────────────────
ARISE_DEFAULT_SIMULATIONS=1000
ARISE_MAX_SIMULATIONS=5000
ARISE_SEED=42                      # fixed seed -> reproducible, auditable projections

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Upstox ────────────────────────────────────────────────────────────────────
UPSTOX_ENABLED=false
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/callback
# The DEDICATED Upstox login the feed worker connects as -- never an
# individual investor's personal account. Set this to that account's
# Upstox user_id (UCC) AFTER it has completed GET /auth/upstox/login once.
UPSTOX_SERVICE_ACCOUNT_USER_ID=
